# Public template only: never put real keys in this tracked example or NEXT_PUBLIC_*.
# If needed, copy this to ignored .env yourself and chmod 600 .env before editing.
PAPERS_DIR=./library
APP_DATA_DIR=./data
LOCAL_UID=501
LOCAL_GID=20
APP_ORIGIN=http://127.0.0.1:3000
# For host development only, point DATABASE_URL at an existing local PostgreSQL.
# Compose builds DATABASE_URL in-process from its postgres_password file secret.
# DATABASE_URL=postgres://thesis:YOUR_LOCAL_DB_PASSWORD@127.0.0.1:5432/thesis

# Optional manually issued keys; name the OpenAI Platform key thesis_parser_key.
# Only the explicit import command reads these into the encrypted credential store.
# No API-key auto-import, container environment injection or paid activation.
# npm run credentials:import -- --from .env --provider openai --confirm-write
OPENAI_API_KEY=
# npm run credentials:import -- --from .env --provider anthropic --confirm-write
ANTHROPIC_API_KEY=
