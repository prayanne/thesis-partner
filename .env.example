# Bootstrap paths only. Never store API keys here or in NEXT_PUBLIC_*.
# Copy/edit this example yourself; the key provisioning flow did not approve .env.local.
PAPERS_DIR=./library
APP_DATA_DIR=./data
LOCAL_UID=501
LOCAL_GID=20
APP_ORIGIN=http://127.0.0.1:3000
# For host development only, point DATABASE_URL at an existing local PostgreSQL.
# Compose builds DATABASE_URL in-process from its postgres_password file secret.
# DATABASE_URL=postgres://thesis:YOUR_LOCAL_DB_PASSWORD@127.0.0.1:5432/thesis
